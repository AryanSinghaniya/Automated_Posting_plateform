# ==============================================================================
# Automated Posting Service - Environment Configuration Example
# Copy this file to .env and replace the placeholder values with your real credentials.
# Active Platforms: Telegram, Mastodon, Bluesky, GitHub Gist, Paste.ee, ntfy.sh
# ==============================================================================

# 1. Telegram Bot Token & Channel ID/Username
# Where to get:
# - Bot Token: Message @BotFather on Telegram (https://t.me/BotFather), run /newbot, follow instructions.
# - Channel: Create a public channel (or private), add your bot as an Administrator with post permissions.
#   Format: @your_channel_name (e.g., @mytechupdates)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_CHANNEL=@mychannel

# 2. Mastodon Base URL & Access Token
# Where to get:
# - Base URL: The URL of your Mastodon instance (default is https://mastodon.social).
# - Access Token: In Mastodon web UI -> Preferences -> Development -> New Application
#   Ensure the scope includes 'write:statuses'.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_TOKEN=your_mastodon_access_token_here

# 3. Bluesky Handle & App Password
# Where to get:
# - Handle: Your Bluesky handle (e.g., user.bsky.social).
# - App Password: Log in to https://bsky.app -> Settings -> Privacy and Security -> App Passwords -> Add App Password.
#   (Never use your main account password!)
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 4. GitHub Personal Access Token (for Gists)
# Where to get:
# - Log in to https://github.com -> Settings -> Developer Settings -> Personal access tokens (classic)
# - Generate new token with the 'gist' scope checked.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# 5. Paste.ee Application API Key
# Where to get:
# - Register/login at https://paste.ee -> Account -> API (https://paste.ee/account/api)
# - Click 'Create Application Key' and copy the token.
PASTEEE_API_KEY=your_pasteee_api_key_here

# 6. ntfy.sh Topic Name
# Where to get:
# - Choose any unique topic name for your public feed (e.g. aryan_tech_updates).
# - View your live feed at https://ntfy.sh/<your_topic_name>
NTFY_TOPIC=aryan_updates
